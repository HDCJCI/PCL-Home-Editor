<!--  PCL 主页工坊 导出 · 2026/11/2 21:06:30 -->
<!--  用法：另存为 PCL\Custom.xaml，放到 PCL 目录的 PCL 文件夹里  -->
<!--        然后在 PCL 中：设置 → 主页 → 选择「自定义主页」        -->
<!--  改坏了直接删掉这个文件即可恢复默认主页                      -->
<!-- ========================================================== -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:PCL;assembly=PCL">

    <TextBlock Text="Plain Craft Launcher 2" FontSize="26" Foreground="#FF16181D" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,2" />
    <TextBlock Text="Minecraft 启动器 · 我的自定义主页" FontSize="12.5" Foreground="#FF8A9099" TextWrapping="Wrap" Margin="0,0,0,16" />
    <local:MyCard Title="启动游戏" CanSwap="False" Margin="0,0,0,12">
        <StackPanel Margin="25,40,23,15">
            <TextBlock Text="Minecraft 1.20.1" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,2" />
            <TextBlock Text="Forge 47.2.0 · Java 17 · 上次游玩 2 天前" FontSize="12" Foreground="#FF8A9099" TextWrapping="Wrap" Margin="0,0,0,14" />
            <local:MyButton Text="启动游戏" ColorType="Highlight" EventType="启动游戏" EventData="26.2" Margin="0,0,0,8" Height="44" />
            <local:MyButton Text="打开游戏目录" EventType="打开文件" EventData="." Margin="0,0,0,12" Height="36" />
            <local:MyHint Text="启动前会自动检查 Java 和内存设置" IsWarn="False" Margin="0,0,0,10" />
        </StackPanel>
    </local:MyCard>
    <local:MyCard Title="公告" CanSwap="False" Margin="0,0,0,12">
        <StackPanel Margin="25,40,23,15">
            <local:MyHint Text="已启用自定义主页，修改后重启 PCL 生效" IsWarn="False" Margin="0,0,0,10" />
            <TextBlock Text="本周更新：&#xA;· 新增 Bangumi 番剧主页预设&#xA;· Modrinth 资源下载体验优化&#xA;· 修复部分情况下启动崩溃的问题" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,0" />
        </StackPanel>
    </local:MyCard>
    <local:MyCard Title="快捷方式" CanSwap="False" Margin="0,0,0,12">
        <StackPanel Margin="25,40,23,15">
            <local:MyListItem Title="哔哩哔哩" Info="看 Minecraft 视频和教程" Type="Clickable" EventType="打开网页" EventData="https://www.bilibili.com" Margin="0,0,0,6" Height="56" />
            <local:MyListItem Title="Minecraft Wiki" Info="查合成表和机制" Type="Clickable" EventType="打开网页" EventData="https://zh.minecraft.wiki" Margin="0,0,0,6" Height="56" />
            <local:MyListItem Title="Modrinth" Info="下载模组和整合包" Type="Clickable" EventType="打开网页" EventData="https://modrinth.com" Margin="0,0,0,0" Height="56" />
        </StackPanel>
    </local:MyCard>
    <local:MyCard Title="最近游玩" CanSwap="False" Margin="0,0,0,0">
        <StackPanel Margin="25,40,23,15">
            <local:MyListItem Title="1.20.1 · Forge" Info="上次游玩：2 天前" Type="Clickable" EventType="启动游戏" Margin="0,0,0,6" Height="56" />
            <local:MyListItem Title="1.19.2 · Fabric" Info="上次游玩：3 周前" Type="Clickable" EventType="启动游戏" Margin="0,0,0,0" Height="56" />
        </StackPanel>
    </local:MyCard>
</StackPanel>